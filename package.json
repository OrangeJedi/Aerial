{
  "name": "aerial",
  "version": "1.3.0",
  "videoJSONVersion": "1.15.0",
  "description": "Apple TV screen saver for Windows",
  "main": "app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.cjs",
    "start": "electron .",
    "dist": "electron-builder",
    "build": "electron-builder build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrangeJedi/Aerial.git"
  },
  "author": "OrangeJedi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OrangeJedi/Aerial/issues"
  },
  "homepage": "https://github.com/OrangeJedi/Aerial#readme",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^12.0.0",
    "ffmpeg-static": "^5.3.0",
    "font-list-universal": "^1.0.0",
    "json-beautify": "^2.0.0",
    "request": "^2.88.2",
    "suncalc": "^2.1.1"
  },
  "build": {
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "perMachine": false
    },
    "portable": {
      "artifactName": "aerial.exe",
      "useZip": true
    },
    "files": [
      "!.test-tmp/**",
      "!documentation/*",
      "!images/*"
    ],
    "icon": "icon.ico",
    "productName": "Aerial"
  }
}
