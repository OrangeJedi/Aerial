{
  "name": "aerial",
  "version": "1.4.2",
  "description": "Apple TV screen saver for Windows",
  "main": "app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "classify": "electron tools/classifier/main.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.cjs",
    "start": "electron .",
    "dist": "electron-builder",
    "build": "electron-builder build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AerialWindows/Aerial.git"
  },
  "author": "AerialWindows",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AerialWindows/Aerial/issues"
  },
  "homepage": "https://github.com/AerialWindows/Aerial#readme",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.15.6"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "font-list-universal": "^1.0.0",
    "json-beautify": "^2.0.0",
    "semver": "^7.8.5",
    "suncalc": "^2.1.1"
  },
  "build": {
    "appId": "com.electron.aerial",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "Aerial-Setup.${ext}",
      "buildUniversalInstaller": true,
      "installerIcon": "icon.ico",
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "aerial.exe",
      "useZip": true
    },
    "files": [
      "!.test-tmp/**",
      "!dist/**",
      "!documentation/*",
      "!images/*"
    ],
    "icon": "icon.ico",
    "productName": "Aerial",
    "publish": [
      {
        "provider": "github",
        "owner": "AerialWindows",
        "repo": "Aerial"
      }
    ]
  }
}
